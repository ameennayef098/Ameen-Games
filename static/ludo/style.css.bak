/* ═══════════════════════════════════════════════════════════════
   لودو الأسئلة والكروت — تصميم بوابة ألعاب
   ─────────────────────────────────────────────────────────────
   🎨 لتغيير ألوان الموقع كاملة: عدّل المتغيرات أدناه فقط
   ═══════════════════════════════════════════════════════════════ */

:root {
  /* ألوان بوابة الألعاب (عدّلها لتطابق موقعك) */
  --portal-dark: #1e2a5e;     /* الكحلي الغامق: الترويسة والتذييل */
  --portal-blue: #2563eb;     /* الأزرق الأساسي */
  --portal-bg: #eef2f9;       /* خلفية الصفحة */
  --card: #ffffff;            /* خلفية البطاقات */
  --ink: #1f2937;             /* نص أساسي */
  --soft: #e2e8f0;            /* حدود خفيفة */

  --green: #22c55e;           /* زر اللعب الأساسي */
  --green-dark: #16a34a;
  --amber: #FDE047;           /* تمييز أصفر */
  --amber-dark: #FACC15;

  /* ألوان رقعة لودو */
  --red: #E53935;
  --green-cell: #43A047;
  --yellow-cell: #FDD835;
  --blue-cell: #1E88E5;
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { margin: 0; padding: 0; }

body {
  background: var(--portal-bg);
  color: var(--ink);
  font-family: 'Tajawal', 'Segoe UI', Tahoma, 'Noto Sans Arabic', 'Noto Kufi Arabic', sans-serif;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

button { font-family: inherit; }
.hidden { display: none !important; }
.center { text-align: center; }
.muted { color: #64748b; font-size: .8rem; margin: 0; }

/* ═══════════ ترويسة الموقع ═══════════ */
.navbar {
  background: linear-gradient(180deg, #27357a, var(--portal-dark));
  color: #fff;
  position: sticky; top: 0; z-index: 40;
  box-shadow: 0 2px 10px rgba(0,0,0,.25);
}
.nav-inner {
  max-width: 72rem; margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between;
  padding: .6rem 1rem;
}
.logo {
  display: flex; align-items: center; gap: .5rem;
  font-weight: 900; font-size: 1.2rem; color: #fff; text-decoration: none; white-space: nowrap;
}
.logo .logo-badge {
  background: linear-gradient(135deg, #f59e0b, #f97316);
  border-radius: .6rem; padding: .1rem .45rem; font-size: 1.15rem;
}
.logo .logo-accent { color: var(--amber); }
.nav-links { display: flex; gap: 1.1rem; }
.nav-links a { color: #c7d2fe; text-decoration: none; font-weight: 700; font-size: .9rem; transition: color .15s; }
.nav-links a:hover { color: #fff; }
@media (max-width: 40rem) { .nav-links { display: none; } }

/* ═══════════ عنوان الصفحة ═══════════ */
.page-head {
  max-width: 72rem; margin: 1.1rem auto .9rem; padding: 0 1rem;
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: .5rem;
}
.page-title { font-size: 1.45rem; font-weight: 900; color: var(--portal-dark); margin: 0; display: flex; align-items: center; gap: .5rem; }
.game-tag {
  background: #dcfce7; color: #15803d;
  border-radius: 999px; padding: .2rem .8rem;
  font-size: .75rem; font-weight: 800;
}

/* ═══════════ الأزرار ═══════════ */
.btn {
  border: none; border-radius: 1rem;
  font-weight: 800; font-size: 1.05rem;
  padding: .75rem 1.5rem;
  background: linear-gradient(180deg, var(--green), var(--green-dark));
  color: #fff; cursor: pointer;
  box-shadow: 0 4px 0 rgba(0,0,0,.18);
  transition: transform .15s ease, filter .15s ease;
}
.btn:hover:not(:disabled) { transform: translateY(-2px); filter: brightness(1.06); }
.btn:active:not(:disabled) { transform: translateY(0); box-shadow: 0 2px 0 rgba(0,0,0,.18); }
.btn:disabled { cursor: not-allowed; background: #cbd5e1; color: #94a3b8; box-shadow: none; }
.btn.big { font-size: 1.4rem; padding: .95rem 2.75rem; border-radius: 1.25rem; }
.btn.small-btn {
  font-size: .85rem; padding: .4rem 1rem; border-radius: .75rem;
  background: #fff; color: var(--portal-dark);
  border: 2px solid #cbd5e1; box-shadow: 0 2px 0 rgba(0,0,0,.08);
}
.btn.small-btn:hover:not(:disabled) { filter: none; background: #f8fafc; }
.btn.teal { background: linear-gradient(180deg, #2dd4bf, #0d9488); }
.btn.teal:hover:not(:disabled) { filter: brightness(1.06); }
.btn.gray { background: #f1f5f9; color: #475569; box-shadow: 0 3px 0 rgba(0,0,0,.1); }
.btn.gray:hover:not(:disabled) { background: #e2e8f0; filter: none; }
.btn.wfull { display: block; width: 100%; }

.link-btn {
  background: none; border: none; padding: 0;
  color: #64748b; font-weight: 700; font-size: .85rem;
  text-decoration: underline; cursor: pointer;
}

/* ═══════════ البطاقات ═══════════ */
.box {
  background: var(--card);
  border: 1px solid var(--soft);
  border-radius: 1rem;
  box-shadow: 0 2px 12px rgba(15,23,42,.07);
  padding: 1rem;
  margin-bottom: .75rem;
}
.box-title { margin: 0 0 .5rem; font-size: .9rem; font-weight: 800; color: var(--portal-dark); }
.box-title-lg { font-size: 1.1rem; margin-bottom: .75rem; }

/* ═══════════ شاشة الإعداد ═══════════ */
.setup { max-width: 42rem; margin: 0 auto; padding: .5rem 1rem 2rem; width: 100%; }
.setup-head { text-align: center; margin-bottom: 1.25rem; }
.setup-head h1 {
  font-size: 2rem; font-weight: 900; margin: 0; color: var(--portal-dark);
}
.setup-head h1 .accent { color: #f59e0b; }
.setup-head p { color: #475569; margin: .4rem 0 0; }

/* منتقي عدد اللاعبين */
.seg { display: flex; gap: .6rem; }
.seg button {
  flex: 1; border: 2px solid var(--soft); background: #fff;
  border-radius: .85rem; padding: .7rem 0;
  font-weight: 800; font-size: 1rem; cursor: pointer; color: #64748b;
  transition: all .15s ease;
}
.seg button:hover { border-color: #94a3b8; }
.seg button.on { border-color: var(--green-dark); background: #dcfce7; color: #15803d; }

.row {
  display: flex; align-items: center; justify-content: space-between; gap: .75rem;
  font-weight: 700; margin-bottom: .75rem;
}
.row.no-margin { margin-bottom: 0; }

.toggle {
  position: relative; width: 3.6rem; height: 1.9rem; flex-shrink: 0;
  border-radius: 999px; border: none;
  background: #cbd5e1; cursor: pointer; transition: background .2s ease;
}
.toggle::after {
  content: ""; position: absolute; top: 3px; right: 3px;
  width: 1.4rem; height: 1.4rem; border-radius: 50%;
  background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.3);
  transition: transform .2s ease;
}
.toggle.on { background: var(--green); }
.toggle.on::after { transform: translateX(-1.7rem); }

.rules {
  border: 2px dashed #cbd5e1; background: #fff;
  border-radius: 1rem; padding: 1rem; margin-top: 1.25rem;
  font-size: .85rem; line-height: 1.9; color: #475569;
}
.rules p { margin: 0; }
.rules .rt { font-weight: 800; color: var(--portal-dark); }

/* ═══════════ التخطيط ═══════════ */
.layout {
  display: grid; gap: 1rem; grid-template-columns: 1fr;
  max-width: 72rem; margin: 0 auto; padding: 0 1rem 2rem;
  width: 100%;
}
@media (min-width: 64rem) {
  .layout { grid-template-columns: minmax(0, 1fr) 20rem; }
}

/* ═══════════ الرقعة 15×15 ═══════════ */
.board {
  position: relative; direction: ltr;
  display: grid; aspect-ratio: 1 / 1; width: 100%; max-width: 35rem;
  grid-template-columns: repeat(15, 1fr); grid-template-rows: repeat(15, 1fr);
  margin: 0 auto; overflow: hidden;
  border: 5px solid var(--portal-dark); border-radius: 1rem; background: #fff;
  box-shadow: 0 6px 20px rgba(15,23,42,.18);
}
.board.bomb-red .cell { background: #E53935 !important; }
.board.bomb-blue .cell { background: #1E88E5 !important; }
.board.bomb-black .cell { background: #111827 !important; }
.board.bomb-black { animation: luBombShake .4s ease-in-out; }
@keyframes luBombShake {
  0%,100% { transform: translate(0,0); }
  20% { transform: translate(-6px, 4px); }
  40% { transform: translate(6px,-4px); }
  60% { transform: translate(-4px,-6px); }
  80% { transform: translate(4px, 6px); }
}
.cell {
  position: relative; display: flex; align-items: center; justify-content: center;
  border: 1px solid #d4d4d4; min-width: 0; min-height: 0;
}
.cell.center { border-color: transparent; }
.cell.safe-star::before {
  content: "★"; position: absolute; font-size: .6rem; line-height: 1; color: #737373; z-index: 1;
}
.cell.start::before {
  content: "▶"; position: absolute; font-size: .6rem; line-height: 1; color: #fff; z-index: 1;
}

/* ألوان الخلايا */
.c-red    { background: var(--red); }
.c-green  { background: var(--green-cell); }
.c-yellow { background: var(--yellow-cell); }
.c-blue   { background: var(--blue-cell); }
.b-red    { background: #F8D0CE; }
.b-green  { background: #CFE8CC; }
.b-yellow { background: #FDF3C0; }
.b-blue   { background: #CCE0F5; }
.h-red    { background: #F8D0CE; border-color: var(--red) !important; }
.h-green  { background: #CFE8CC; border-color: var(--green-cell) !important; }
.h-yellow { background: #FDF3C0; border-color: var(--yellow-cell) !important; }
.h-blue   { background: #CCE0F5; border-color: var(--blue-cell) !important; }

/* الأحجار */
.piece {
  position: absolute; left: 50%; top: 50%; padding: 0;
  border: 2px solid #fff; border-radius: 50%;
  box-shadow: 1px 2px 3px rgba(0,0,0,.4); z-index: 10;
}
.piece.selectable {
  z-index: 20; cursor: pointer;
  outline: 4px solid var(--amber-dark); outline-offset: 1px;
  animation: selPulse 1.1s ease-in-out infinite;
}
@keyframes selPulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }

/* مثلثات المركز وشارات الإنجاز */
.center-tri { position: absolute; left: 40%; top: 40%; width: 20%; height: 20%; pointer-events: none; z-index: 5; }
.tri { position: absolute; inset: 0; }
.done-badge {
  position: absolute; z-index: 6;
  background: rgba(255,255,255,.95); border-radius: 999px;
  padding: 0 .25rem; font-size: .65rem; font-weight: 700; color: #262626;
  box-shadow: 0 1px 2px rgba(0,0,0,.3);
}
.pos-red    { left: 4%;  top: 50%; transform: translateY(-50%); }
.pos-green  { top: 4%;   left: 50%; transform: translateX(-50%); }
.pos-yellow { right: 4%; top: 50%; transform: translateY(-50%); }
.pos-blue   { bottom: 4%; left: 50%; transform: translateX(-50%); }

/* ═══════════ صندوق الدور ═══════════ */
.turn-head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .5rem; }
.who { display: flex; align-items: center; gap: .5rem; min-width: 0; }
.dot {
  display: inline-block; width: 1.25rem; height: 1.25rem; flex-shrink: 0;
  border-radius: 50%; border: 2px solid #fff; box-shadow: 0 1px 2px rgba(0,0,0,.3);
}
.dot.sm { width: 1rem; height: 1rem; }
.badge {
  background: #FEF3C7; color: #92400E; border-radius: 999px;
  padding: .15rem .55rem; font-size: .7rem; font-weight: 700; white-space: nowrap; flex-shrink: 0;
}
.instruction { margin: 0 0 .75rem; font-size: .875rem; font-weight: 700; color: #475569; }
.dice-row { display: flex; align-items: center; gap: .75rem; }
.dice-row .btn { flex: 1; }
.streak { margin: .5rem 0 0; font-size: .7rem; font-weight: 700; color: #EA580C; }

.dice {
  display: grid; flex-shrink: 0;
  grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); gap: 2px;
  width: 52px; height: 52px; padding: 4px;
  border: 3px solid var(--ink); border-radius: .75rem; background: #fff;
  box-shadow: 0 3px 0 rgba(0,0,0,.15);
}
.dice i {
  display: block; width: 8px; height: 8px; border-radius: 50%;
  background: var(--ink); align-self: center; justify-self: center;
}

/* ═══════════ الكروت اليد ═══════════ */
.card-btn {
  display: block; width: 100%; text-align: right;
  border: none; border-radius: .75rem;
  padding: .55rem .8rem; margin-bottom: .5rem;
  color: #fff; font-weight: 800; font-size: .85rem;
  box-shadow: 0 3px 0 rgba(0,0,0,.2);
  cursor: pointer; transition: transform .15s ease, filter .15s ease;
}
.card-btn:last-child { margin-bottom: 0; }
.card-btn:hover:not(:disabled) { transform: translateY(-2px); filter: brightness(1.07); }
.card-btn:disabled { opacity: .55; cursor: default; }

/* ═══════════ قائمة اللاعبين والسجل ═══════════ */
.player-row {
  display: flex; flex-direction: column; gap: .15rem;
  border: 2px solid var(--soft); border-radius: .75rem;
  padding: .5rem .75rem; margin-bottom: .5rem;
}
.player-row:last-child { margin-bottom: 0; }
.player-row.current { border-color: var(--green); background: #f0fdf4; }
.pname { font-size: .85rem; font-weight: 700; }
.counts { font-size: .65rem; color: #64748b; }

.log {
  list-style: none; margin: 0; padding: 0;
  max-height: 10rem; overflow-y: auto;
  font-size: .72rem; line-height: 1.7; color: #475569;
}
.log .first { font-weight: 700; color: var(--ink); }

/* ═══════════ النوافذ المنبثقة ═══════════ */
.overlay {
  position: fixed; inset: 0; z-index: 50; padding: 1rem;
  display: flex; align-items: center; justify-content: center;
  background: rgba(15,23,42,.55); backdrop-filter: blur(4px);
}
.modal {
  width: 100%; max-width: 32rem; max-height: 92vh; overflow-y: auto;
  background: #fff; border: 1px solid var(--soft); border-radius: 1.25rem;
  box-shadow: 0 24px 60px rgba(0,0,0,.35); padding: 1.25rem;
}
.modal.narrow { max-width: 24rem; }

/* نافذة السؤال */
.q-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: .75rem; }
.q-player { border-radius: 999px; padding: .25rem .8rem; font-size: .85rem; font-weight: 700; color: #fff; }
.timer {
  border-radius: 999px; background: #f1f5f9; color: #475569;
  padding: .25rem .75rem; font-size: .85rem; font-weight: 700;
}
.timer.urgent { background: #FEE2E2; color: #B91C1C; }
.q-text { text-align: center; font-size: 1.25rem; font-weight: 700; line-height: 1.7; margin: 0 0 1rem; }
.q-grid { display: grid; grid-template-columns: 1fr; gap: .7rem; }
.option-btn {
  border: 2px solid var(--soft); background: #fff; border-radius: .9rem;
  padding: .75rem 1rem; font-size: 1.05rem; font-weight: 700; text-align: right;
  cursor: pointer; transition: transform .15s ease, border-color .15s ease;
}
.option-btn:hover:not(:disabled) { transform: translateY(-2px); border-color: var(--portal-blue); }
.option-btn:disabled { cursor: default; }
.option-btn.correct { border-color: #16A34A; background: #F0FDF4; color: #166534; }
.option-btn.wrong   { border-color: #EF4444; background: #FEF2F2; color: #B91C1C; }
.option-btn.dim     { border-color: #f1f5f9; color: #94a3b8; }
.result-banner {
  margin-top: 1rem; border-radius: .9rem; padding: .75rem 1rem;
  text-align: center; font-size: 1.05rem; font-weight: 800;
}
.result-banner.good { background: #DCFCE7; color: #166534; }
.result-banner.bad  { background: #FEE2E2; color: #991B1B; }

/* نافذة الكرت */
.muted-line { color: #475569; font-weight: 700; margin: 0 0 .75rem; text-align: center; }
.strong { font-size: 1.25rem; font-weight: 800; margin: 0 0 .25rem; text-align: center; color: var(--portal-dark); }
.card-visual {
  width: 11rem; margin: 0 auto 1rem; transform: rotate(-3deg);
  border-radius: 1rem;
  padding: 1rem; color: #fff; text-align: center;
  box-shadow: 0 10px 24px rgba(0,0,0,.3);
}
.card-visual.small { width: 10rem; padding: .75rem; }
.card-visual .big { font-size: 2.5rem; }
.card-visual.small .big { font-size: 1.9rem; }
.card-visual .cname { margin-top: .25rem; font-size: 1.05rem; font-weight: 800; }
.cdesc { font-size: .85rem; line-height: 1.7; color: #475569; margin: 0 0 1.25rem; text-align: center; }
.fifth-list { display: flex; flex-direction: column; gap: .5rem; }
.discard-btn {
  display: flex; align-items: center; justify-content: space-between;
  border: 2px solid var(--soft); background: #fff; border-radius: .9rem;
  padding: .5rem 1rem; font-weight: 700; cursor: pointer;
  transition: transform .15s ease, border-color .15s ease;
}
.discard-btn:hover { transform: translateY(-2px); border-color: var(--portal-blue); }
.discard-btn .small { font-size: .7rem; color: #94a3b8; }

/* نافذة أرقام كرت الخطوات */
.num-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: .5rem; margin: 0 0 1rem; }
.num-btn {
  border: 2px solid var(--portal-blue); background: #dbeafe; border-radius: .75rem;
  padding: .5rem 0; font-size: 1.1rem; font-weight: 800; cursor: pointer; color: #1d4ed8;
  transition: transform .15s ease, filter .15s ease;
}
.num-btn:hover:not(:disabled) { transform: translateY(-2px); filter: brightness(1.04); }
.num-btn:disabled { border-color: #f1f5f9; background: #f8fafc; color: #cbd5e1; cursor: not-allowed; }

/* أنيميشن انفجار القنبلة */
.bomb-explode { animation: luBombPop .7s cubic-bezier(.4,.9,.3,1.2); }
@keyframes luBombPop {
  0% { transform: scale(1); opacity: 1; }
  30% { transform: scale(1.4); opacity: .7; }
  60% { transform: scale(.9); opacity: .9; }
  100% { transform: scale(1); opacity: 1; }
}

/* نافذة الفوز */
.win-emoji { font-size: 3.75rem; text-align: center; margin-bottom: .5rem; }
.win-title { font-size: 1.875rem; font-weight: 800; margin: 0 0 .25rem; text-align: center; color: var(--portal-dark); }
.win-name  { font-size: 1.875rem; font-weight: 800; margin: 0 0 1.5rem; text-align: center; }

/* ═══════════ تذييل الموقع ═══════════ */
.footer {
  background: var(--portal-dark); color: #94a3c8;
  text-align: center; padding: 1.2rem 1rem; margin-top: auto;
  font-size: .8rem;
}
.footer b { color: #fff; }

/* هواتف صغيرة جدًا */
@media (max-width: 22rem) {
  .setup-head h1 { font-size: 1.6rem; }
  .num-grid { gap: .35rem; }
}
