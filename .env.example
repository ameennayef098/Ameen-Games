NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# كلمة مرور لوحة الإدارة — كلا الشكلين اختياري:
#   ADMIN_PASSWORD      نص صريح (الأسهل ضبطًا في لوحة الاستضافة)
#   ADMIN_PASSWORD_HASH بصمة SHA-256 من 64 حرفًا سداسيًا
# إن تُرك الاثنان فارغين تُستخدم كلمة المرور الاحتياطية المدمجة في الكود.
# قيمة غير صالحة الشكل في ADMIN_PASSWORD_HASH تُتجاهَل مع تحذير في سجل التشغيل،
# ولا تُقفل لوحة الإدارة.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
