def _to_int(s):
    if s is None:
        return None
    try:
        return int(str(s).translate(_DIGITS).strip())
    except (TypeError, ValueError):
        return None


def norm_ar(t):
    if not t:
        return ''
    t = str(t)
    t = re.sub(r'[ً-ْٰـ]', '', t)
    t = re.sub(r'[أإآٱ]', 'ا', t)
    t = t.replace('ة', 'ه').replace('ى', 'ي').replace('ؤ', 'و').replace('ئ', 'ي')
    t = re.sub(r'[^\w\s؀-ۿ]', ' ', t)
    return re.sub(r'\s+', ' ', t).strip()


